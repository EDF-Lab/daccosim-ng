<mxStylesheet>
	<add as="defaultVertex">
        <add as="perimeter" value="rectanglePerimeter"/>
        <add as="fontSize" value="12"/>
		<add as="fontColor" value="white"/>
		<add as="fontFamily" value="Arial"/>
		<add as="fontStyle" value="1"/>
		<add as="align" value="center"/>
		<add as="verticalAlign" value="middle"/>
	</add>
	<add as="defaultEdge">
		<add as="shape" value="connector"/>
		<add as="edgeStyle" value="elbowEdgeStyle"/>
		<add as="labelBackgroundColor" value="white"/>
		<add as="endArrow" value="classic"/>
		<add as="endSize" value="15"/>
		<add as="fontSize" value="12"/>
		<add as="align" value="center"/>
		<add as="verticalAlign" value="middle"/>
		<add as="edgeStyle" value="elbowEdgeStyle"/>
		<add as="strokeWidth" value="2"/>
		<add as="strokeColor" value="black"/>
	</add>
	<add as="fmu" extend="defaultVertex">
        <add as="shape" value="rectangle"/>
		<add as="fillColor" value="#2DB100"/>
	</add>
    <add as="matryoshka" extend="fmu">
        <add as="fillColor" value="#f03b20"/>
    </add>
	<add as="circle" extend="defaultVertex">
		<add as="shape" value="ellipse"/>
		<add as="fontSize" value="20"/>
		<add as="fillColor" value="#cdcdcd"/>
		<add as="strokeWidth" value="2"/>
		<add as="strokeColor" value="black"/>
		<add as="fontColor" value="black"/>
	</add>
	<add as="adder" extend="circle"/>
	<add as="multiplier" extend="circle"/>
	<add as="gain" extend="circle"/>
	<add as="offset" extend="circle"/>
	<add as="triangle">
		<add as="shape" value="triangle"/>
		<add as="perimeter" value="trianglePerimeter"/>
	</add>
	<add as="externalinput" extend="triangle">
		<add as="align" value="left"/>
		<add as="fillColor" value="#0955EF"/>
	</add>
	<add as="externaloutput" extend="triangle">
		<add as="align" value="left"/>
		<add as="fillColor" value="white"/>
		<add as="strokeColor" value="#D71A05"/>
		<add as="strokeWidth" value="3"/>
		<add as="fontColor" value="black"/>
	</add>
</mxStylesheet>
